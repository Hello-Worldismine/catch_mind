# Supabase 대시보드 → Project Settings → API (또는 API Keys) 에서 복사하세요.
# 브라우저에 노출되어도 되는 값만 넣습니다. (service_role / secret 키는 절대 넣지 마세요!)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# 새 키 형식(sb_publishable_...) 또는 기존 anon 키(eyJ...) 둘 다 사용 가능
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
